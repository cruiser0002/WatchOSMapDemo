{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".indexOn": ["expireAt", "createdAt", "lastActivityTimestamp"],
      "$roomId": {
        ".read": true,
        ".write": true,
        ".validate": "$roomId.length > 0 && $roomId.length <= 64"
      }
    },
    "telemetry": {
      "$roomId": {
        ".read": true,
        ".write": "root.child('rooms').child($roomId).exists()"
      }
    },
    "tactical": {
      "$roomId": {
        ".read": true,
        ".write": "root.child('rooms').child($roomId).exists()"
      }
    }
  }
}
