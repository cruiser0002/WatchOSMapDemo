{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".indexOn": ["createdAt", "lastActivityTimestamp"],
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$roomId.length > 0",
        "members": {
          ".read": "auth != null",
          "$memberId": {
            ".read": "auth != null",
            ".write": "auth != null",
            ".validate": "newData.hasChild('callsign') && newData.child('callsign').val().length > 0"
          }
        }
      }
    },
    "telemetry": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$memberId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "tactical": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$memberId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
