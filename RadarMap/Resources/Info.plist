<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>WKCompanionAppBundleIdentifier</key>
    <string>com.radarmap.watch</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>Radar Map</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>WatchOS</string>
    </array>
    <key>UIDeviceFamily</key>
    <array>
        <integer>4</integer>
    </array>
    <key>MinimumOSVersion</key>
    <string>10.0</string>
    <key>WKApplication</key>
    <true/>
    <key>WKRunsIndependentlyOfCompanionApp</key>
    <true/>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Radar Map requires your location to display your position on the tactical milsim map and share it with your squad.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Radar Map tracks tactical coordinates during active squad sessions.</string>
    <key>NSHealthShareUsageDescription</key>
    <string>Radar Map reads your heart rate to stream live squad biometric stress levels to teammates.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>Radar Map records tactical workout sessions to maintain live heart rate streaming.</string>
    <key>WKBackgroundModes</key>
    <array>
        <string>workout-processing</string>
    </array>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
