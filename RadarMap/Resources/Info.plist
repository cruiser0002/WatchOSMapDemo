    <key>NSHealthUpdateUsageDescription</key>
    <string>Radar Map records tactical workout sessions to maintain live heart rate streaming.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Radar Map uses Bluetooth Low Energy for nearby squad room discovery and peer synchronization.</string>
    <key>WKBackgroundModes</key>
    <array>
        <string>workout-processing</string>
        <string>location</string>
    </array>
